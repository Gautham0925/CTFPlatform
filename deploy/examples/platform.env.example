# Arena platform configuration (Profiles B and C).
# Copy to deploy/.env and run deploy/scripts/gen-secrets.sh to fill the
# CHANGE_ME values. Never commit the real file (it is git-ignored).

# ---- Public endpoint -------------------------------------------------------
ARENA_DOMAIN=ctf.example.org
# Used in certificate verification links and runner callbacks.
ARENA_PUBLIC_URL=https://ctf.example.org

# ---- Secrets (generated) -------------------------------------------------
SECRET_KEY=CHANGE_ME
# Separate key for Arena encryption (lab credentials) and HMACs. 32+ chars.
ARENA_SECRET_KEY=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ---- Application ---------------------------------------------------------
# gunicorn gevent workers per web container.
WORKERS=2
# (Profile C: 4 per web replica.)
ARENA_ENABLED=true
# Certificates are optional and disabled by default.
ARENA_CERTIFICATES_ENABLED=false
# mock = no challenge containers; remote = separate runner host (Profile C).
ARENA_RUNNER_MODE=mock
ARENA_RUNNER_URL=
ARENA_RUNNER_KEY_ID=
ARENA_RUNNER_SECRET=
# Path INSIDE the container of the runner CA bundle (mounted read-only).
ARENA_RUNNER_CA=
# Hosts on private networks that external labs may use (comma separated).
ARENA_LAB_ALLOWED_PRIVATE_HOSTS=
# nginx per-IP limits: exempt ONE trusted range (e.g. venue NAT), CIDR form.
# Leave empty for no exemption. Accounts stay rate-limited by the app.
ARENA_RATELIMIT_EXEMPT_CIDR=
# Retention (days)
ARENA_ACTIVITY_RETENTION_DAYS=90
ARENA_AUDIT_RETENTION_DAYS=365
