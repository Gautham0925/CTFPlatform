# Arena runner host configuration (Profile C). Copy to runner/.env on the
# RUNNER HOST ONLY. The CTFd host never receives the Docker socket.

# key_id:secret pairs, comma separated; secret >= 32 chars. The same key_id and
# secret go into ARENA_RUNNER_KEY_ID / ARENA_RUNNER_SECRET on the platform.
ARENA_RUNNER_KEYS=platform1:CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG____
ARENA_RUNNER_BACKEND=docker
# Images must be pinned by digest: registry/name@sha256:<64 hex>
ARENA_RUNNER_ALLOWED_IMAGES=
# Address participants use to reach challenge ports, and the NIC they bind to.
ARENA_RUNNER_PUBLIC_HOST=runner.example.org
ARENA_RUNNER_BIND_IP=203.0.113.10
ARENA_RUNNER_PORT_RANGE=30000-30999
ARENA_RUNNER_MAX_INSTANCES=200
ARENA_RUNNER_MAX_TTL=14400
# Optional: runsc (gVisor) if installed on the runner host.
ARENA_RUNNER_DOCKER_RUNTIME=
