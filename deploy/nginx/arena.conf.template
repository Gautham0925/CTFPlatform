# Arena edge proxy (Profiles B/C). ${ARENA_DOMAIN} is substituted by the
# nginx image's envsubst templating at container start. Certificates go in
# deploy/nginx/certs/{fullchain.pem,privkey.pem} (Let's Encrypt or your CA;
# deploy/scripts/selfsigned-cert.sh creates a test pair).

# Docker's embedded DNS; re-resolve so scaled/restarted web replicas are seen.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream arena_app {
  zone arena_app 64k;
  # One reset must not eject a replica for 10s (nginx defaults max_fails=1):
  # under load that turned a single keep-alive race into "no live upstreams".
  server ctfd:8000 resolve max_fails=5 fail_timeout=5s;
  keepalive 32;
  # Must stay BELOW gunicorn's --keep-alive (GUNICORN_CMD_ARGS in compose) so
  # nginx never reuses a connection gunicorn is closing.
  keepalive_timeout 30s;
}

# Coarse anti-flood limits per client IP. The application enforces its own
# per-account limits. Venues where many players share one NAT address should
# raise these (see DEPLOYMENT_GUIDE "Rate limits behind NAT").
# ARENA_RATELIMIT_EXEMPT_CIDR (deploy/.env) exempts one trusted range, e.g. a
# venue NAT. The default is a TEST-NET address, i.e. nobody is exempt.
geo $arena_rl_exempt {
  default 0;
  ${ARENA_RATELIMIT_EXEMPT_CIDR} 1;
}
map $arena_rl_exempt $arena_rl_key { 0 $binary_remote_addr; 1 ""; }
limit_req_zone $arena_rl_key zone=arena_auth:10m rate=30r/m;
limit_req_zone $arena_rl_key zone=arena_flag:10m rate=120r/m;
limit_req_zone $arena_rl_key zone=arena_api:20m rate=30r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

server {
  listen 80;
  server_name ${ARENA_DOMAIN};
  location = /nginx-health { access_log off; return 200 "ok\n"; }
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${ARENA_DOMAIN};

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;

  client_max_body_size 100m;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  # nginx is the edge: OVERWRITE client-supplied forwarding headers so
  # CTFd's ProxyFix (1 trusted hop) sees the real peer address.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Forwarded-Prefix "";
  proxy_read_timeout 60s;
  # Retry idempotent requests on another replica if one connection fails.
  proxy_next_upstream error timeout http_502;
  proxy_next_upstream_tries 2;

  # Native notification stream (Server-Sent Events).
  location = /events {
    proxy_pass http://arena_app;
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 1h;
  }

  location ~ ^/(login|register|reset_password|confirm) {
    limit_req zone=arena_auth burst=30 nodelay;
    proxy_pass http://arena_app;
  }

  # Flag submissions (native and Arena).
  location ~ ^/api/v1/(challenges/attempt|arena/events/\d+/(challenges/\d+/attempt|ad/flags))$ {
    limit_req zone=arena_flag burst=60 nodelay;
    proxy_pass http://arena_app;
  }

  location /api/ {
    limit_req zone=arena_api burst=100 nodelay;
    proxy_pass http://arena_app;
  }

  # Readiness exposes only booleans; keep it reachable for external monitors.
  location = /arena/readyz { access_log off; proxy_pass http://arena_app; }

  location / {
    proxy_pass http://arena_app;
  }
}
