[Unit]
Description=Arena background worker
After=arena-web.service
Requires=mariadb.service

[Service]
User=ctfd
Group=ctfd
WorkingDirectory=/opt/arena
EnvironmentFile=/etc/arena/arena.env
# Override the repo .flaskenv (FLASK_ENV=development) for flask CLI commands.
Environment=FLASK_ENV=production FLASK_DEBUG=0
ExecStart=/opt/arena/.venv/bin/flask arena worker
# The worker finishes its current job on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arena/uploads /var/log/arena
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
